 // hasLegacyVersion checks if the given version exists in the legacy format.
+// keyExists reports whether key is present regardless of its value.
+// NOTE(passage hop2 fix): db.Has()/db.Get() treat a zero-length value as
+// absent, which misreports EMPTY iavl roots (an empty tree, e.g. x/evidence on
+// a chain with no evidence, stores its root under r<version> (legacy) or
+// nodeKeyFormat (native) with an empty value). This value-agnostic iterator
+// check (matching getLegacyLatestVersion) is required to load empty stores
+// across the 0.47(iavl0.20)->0.50(iavl1) upgrade AND to reload the 0.50-written
+// db afterwards ("version does not exist").
+func (ndb *nodeDB) keyExists(key []byte) (bool, error) {
+	itr, err := ndb.db.Iterator(key, nil)
+	if err != nil {
+		return false, err
+	}
+	defer itr.Close()
+	return itr.Valid() && bytes.Equal(itr.Key(), key), itr.Error()
+}
+
